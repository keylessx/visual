-- Flash TP
local flashEnabled = false
local flashCooldown = false
local cooldownTime = 3 -- 3 seconds cooldown

flashBtn.MouseButton1Click:Connect(function()
    flashEnabled = not flashEnabled
    if flashEnabled then
        flashBtn.Text = "FLASH TP: ON"
    else
        flashBtn.Text = "FLASH TP: OFF"
    end
end)

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Q and flashEnabled and not flashCooldown then
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            
            -- Calculate blink distance (20 studs forward)
            local blinkDistance = 20
            local lookVector = hrp.CFrame.LookVector
            local targetPos = hrp.Position + (lookVector * blinkDistance)
            
            -- Create blink effect at start
            local blinkPart = Instance.new("Part")
            blinkPart.Anchored = true
            blinkPart.CanCollide = false
            blinkPart.Size = Vector3.new(3, 3, 3)
            blinkPart.Position = hrp.Position
            blinkPart.Transparency = 0.5
            blinkPart.Material = Enum.Material.Neon
            blinkPart.Color = Color3.fromRGB(255, 50, 50)
            blinkPart.Parent = workspace
            
            local blinkPart2 = blinkPart:Clone()
            blinkPart2.Position = targetPos
            blinkPart2.Parent = workspace
            
            -- Teleport forward
            hrp.CFrame = CFrame.new(targetPos, targetPos + lookVector)
            
            -- Fade out effect
            task.spawn(function()
                for i = 1, 10 do
                    blinkPart.Transparency = blinkPart.Transparency + 0.05
                    blinkPart.Size = blinkPart.Size + Vector3.new(0.5, 0.5, 0.5)
                    blinkPart2.Transparency = blinkPart2.Transparency + 0.05
                    blinkPart2.Size = blinkPart2.Size + Vector3.new(0.5, 0.5, 0.5)
                    task.wait(0.03)
                end
                blinkPart:Destroy()
                blinkPart2:Destroy()
            end)
            
            -- Start cooldown
            flashCooldown = true
            local startTime = tick()
            
            task.spawn(function()
                while tick() - startTime < cooldownTime do
                    local elapsed = tick() - startTime
                    local progress = elapsed / cooldownTime
                    local percentage = math.floor(progress * 100)
                    
                    cooldownFill.Size = UDim2.new(progress, 0, 1, 0)
                    cooldownText.Text = percentage .. "%"
                    
                    -- Change color based on progress
                    if progress < 0.5 then
                        cooldownFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                    elseif progress < 0.8 then
                        cooldownFill.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
                    else
                        cooldownFill.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
                    end
                    
                    task.wait(0.05)
                end
                
                -- Reset to 100%
                cooldownFill.Size = UDim2.new(1, 0, 1, 0)
                cooldownFill.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
                cooldownText.Text = "100%"
                flashCooldown = false
            end)
        end
    end
end)
