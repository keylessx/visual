local function createBtn(text, pos)
    local btn = Instance.new("TextButton", main)
    btn.Size = UDim2.new(1, -30, 0, 45)
    btn.Position = pos
    btn.BackgroundColor3 = C.btnBg
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = C.white
    btn.TextSize = 16
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = C.btnStroke
    stroke.Thickness = 1.5

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = C.btnHover}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = C.borderGlow}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = C.btnBg}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = C.btnStroke}):Play()
    end)

    return btn
end

