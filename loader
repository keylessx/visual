        while loadGui.Parent do
            TweenService:Create(snowflakeLbl, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextTransparency = 0.45}):Play()
            task.wait(1.2)
