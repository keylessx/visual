-- Animated loading
task.spawn(function()
    -- Fast loading from 0-95% (30 seconds)
    for i = 0, 95 do
        loadBarFill.Size = UDim2.new(i / 100, 0, 1, 0)
        loadPercent.Text = i .. "%"
        
        if i < 20 then
            loadSubtitle.Text = "Initializing..."
        elseif i < 40 then
            loadSubtitle.Text = "Loading modules..."
        elseif i < 60 then
            loadSubtitle.Text = "Setting up interface..."
        elseif i < 80 then
            loadSubtitle.Text = "Configuring features..."
        else
            loadSubtitle.Text = "Almost ready..."
        end
        
        task.wait(0.3) -- Fast: 0.3 seconds per percent
    end
    
    -- Slow loading from 95-100% (4.5 minutes = 270 seconds for 5%)
    loadSubtitle.Text = "Finalizing... (This may take a while)"
    for i = 96, 100 do
        loadBarFill.Size = UDim2.new(i / 100, 0, 1, 0)
        loadPercent.Text = i .. "%"
        task.wait(54) -- Very slow: 54 seconds per percent (270 seconds / 5 = 54)
    end
    
    loadSubtitle.Text = "Complete!"
    task.wait(0.5)
    
    -- Fade out
    for i = 1, 10 do
        loadFrame.BackgroundTransparency = i / 10
        loadFrameStroke.Transparency = i / 10
        loadTitle.TextTransparency = i / 10
        loadSubtitle.TextTransparency = i / 10
        loadBarBg.BackgroundTransparency = i / 10
        loadBarFill.BackgroundTransparency = i / 10
        loadPercent.TextTransparency = i / 10
        task.wait(0.03)
    end
    
    loadGui:Destroy()
end)

