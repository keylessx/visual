            task.wait(1.2)
        end
    end)

    -- Floating bg icons gentle drift
    for idx, lbl in ipairs(bgIcons) do
        task.spawn(function()
            local baseY = lbl.Position.Y.Scale
            task.wait(idx * 0.25)
            while loadGui.Parent do
                TweenService:Create(lbl, TweenInfo.new(3 + idx * 0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Position = UDim2.new(lbl.Position.X.Scale, lbl.Position.X.Offset, baseY - 0.022, lbl.Position.Y.Offset)
                }):Play()
                task.wait(3 + idx * 0.35)
                TweenService:Create(lbl, TweenInfo.new(3 + idx * 0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Position = UDim2.new(lbl.Position.X.Scale, lbl.Position.X.Offset, baseY + 0.022, lbl.Position.Y.Offset)
                }):Play()
                task.wait(3 + idx * 0.35)
            end
        end)
    end

    -- Feature icon boxes cycle highlight
    task.spawn(function()
        local current = 1
        while loadGui.Parent do
            for i, data in ipairs(iconFrames) do
                local isActive = (i == current)
                TweenService:Create(data.stroke, TweenInfo.new(0.3), {
                    Color = isActive and C.borderGlow or C.btnStroke
                }):Play()
                TweenService:Create(data.box, TweenInfo.new(0.3), {
                    BackgroundColor3 = isActive and C.bgMid or C.bg
                }):Play()
            end
            current = (current % #iconFrames) + 1
            task.wait(1.1)
        end
    end)

    -- Rolling snowflake on bar tip
    task.spawn(function()
        local rot = 0
        while loadGui.Parent do
            rot = (rot + 15) % 360
            -- Spin effect by cycling through snowflake variants
            local spinFrames = {"❄", "❅", "❆", "❅"}
            barSnowflake.Text = spinFrames[math.floor(rot / 90) + 1] or "❄"
            task.wait(0.06)
        end
    end)

    -- Fast 0-95%
    for i = 0, 95 do
        TweenService:Create(loadBarFill, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {Size = UDim2.new(i / 100, 0, 1, 0)}):Play()
        TweenService:Create(barSnowflake, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {Position = UDim2.new(i / 100, -11, 0.5, -11)}):Play()
        loadPercent.Text = i .. "%"
        if i < 20 then
            loadSubtitle.Text = "❄  Initializing freeze engine..."
        elseif i < 40 then
            loadSubtitle.Text = "🎯  Loading trade interceptors..."
        elseif i < 60 then
            loadSubtitle.Text = "⚡  Connecting force accept hooks..."
        elseif i < 80 then
            loadSubtitle.Text = "🔒  Configuring victim scanner..."
        else
            loadSubtitle.Text = "🌊  Almost ready..."
        end
        local t = i / 95
        loadBarFill.BackgroundColor3 = Color3.new(
            C.barFill.R + (C.barFillEnd.R - C.barFill.R) * t,
            C.barFill.G + (C.barFillEnd.G - C.barFill.G) * t,
            C.barFill.B + (C.barFillEnd.B - C.barFill.B) * t
        )
        task.wait(0.3)
    end

    -- Slow 95-100%
    loadSubtitle.Text = "💎  Finalizing... (This may take a while)"
    for i = 96, 100 do
        TweenService:Create(loadBarFill, TweenInfo.new(50, Enum.EasingStyle.Linear), {Size = UDim2.new(i / 100, 0, 1, 0)}):Play()
        TweenService:Create(barSnowflake, TweenInfo.new(50, Enum.EasingStyle.Linear), {Position = UDim2.new(i / 100, -11, 0.5, -11)}):Play()
        loadPercent.Text = i .. "%"
        task.wait(54)
    end

    -- Complete
    barSnowflake.Text = "✅"
    loadSubtitle.Text = "✅  Ready!"
    loadPercent.Text = "100%"
    readyLbl.Text = "  Ready  \xE2\x80\xA2  Freeze Trade v5.0"
    readyDot.BackgroundColor3 = C.coolGreen
    task.wait(0.8)

    -- Fade everything out
    TweenService:Create(loadBg, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
    for _, obj in pairs({loadFrame, topBar, bottomBar}) do
        TweenService:Create(obj, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
    end
    for _, lbl in pairs({loadTitle, loadVersion, loadSubtitle, loadPercent, readyLbl, snowflakeLbl}) do
        TweenService:Create(lbl, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    end
    for _, fr in pairs({loadBarFill, loadBarBg, divider, readyDot, snowflakeIcon, barSnowflake}) do
        TweenService:Create(fr, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    end
    for _, lbl in pairs(bgIcons) do
        TweenService:Create(lbl, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    end
    for _, data in pairs(iconFrames) do
        TweenService:Create(data.box, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(data.iconLbl, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        TweenService:Create(data.labelLbl, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    end
    TweenService:Create(loadFrameStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
    task.wait(0.6)
    loadGui:Destroy()
end)

